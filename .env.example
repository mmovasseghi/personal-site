# Copy to .env.local for custom configuration

# Site URL (used in metadata)
NEXT_PUBLIC_SITE_URL=https://mmovasseghi.dev

# GitHub Pages subpath (only if deploying to username.github.io/repo-name)
# NEXT_PUBLIC_BASE_PATH=/repo-name

# Enable static export (set automatically by build:static script)
# STATIC_EXPORT=true
